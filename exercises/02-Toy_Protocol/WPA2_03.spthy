theory WPA2_03
begin

builtins: symmetric-encryption

functions: kdf/3, mac/2    // SK = kdf(MK, na, nb), mac = mac(key, message)

rule init_MK:
    [ Fr(~mk) ]
    --[ ]->
    [ !MK($A, $B, ~mk) ]

rule Alex_nonce:
    [ Fr(~na) ]
    --[ Send($A, $B, ~na) ]->
    [ Out(~na), State_A1($A, $B, ~na) ]


rule Blake_nonce:
    [ Fr(~nb), In(na) ]
    --[ Receive(na) ]->
    [ Out(~nb), State_B1($B, $A, ~nb, na) ]

rule Alex_ack:
    let
        SK = kdf(mk, ~na, nb)
        MAC = mac(SK, 'ACK')
    in
    [State_A1($A, $B, ~na), In(nb), !MK($A, $B, mk) ]
    --[ Install(SK), DONE_A($A) ]->
    [Out(MAC), SK_Installed_A($A, $B, SK, ~na, nb) ]

rule Blake_ack:
    let
        SK = kdf(mk, na, ~nb)
        MAC = mac(SK, 'ACK')
    in
    [ State_B1($B, $A, ~nb, na), In(MAC), !MK($A, $B, mk) ]
    --[ Install(SK), DONE_B($B) ]->
    [ SK_Installed_B($B, $A, SK, na, ~nb) ]


lemma BothDone:
    exists-trace
    " Ex A B #i #j. DONE_A(A)@i & DONE_B(B)@j & #i < #j "

lemma SecureKey:
    " All B SK #j. DONE_B(B)@#j & Install(SK)@#j ==> not (Ex #r. K(SK)@#r) "

// NOTE:
// I am keeping the EXACT SAME lemma from Step 2 to visually see the improvement.
// In Step 2, this lemma was RED (Falsified) because the ACK could be forged.
// Now in Step 3, thanks to the MAC verification, this exact same lemma is GREEN (Verified).
lemma Blake_Authentication:
    " All B #j. DONE_B(B)@#j ==> Ex A #i. DONE_A(A)@#i & #i < #j "

end
