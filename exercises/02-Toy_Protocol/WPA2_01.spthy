theory WPA2_01
begin

builtins: symmetric-encryption

functions: kdf/2


rule Alex_nonce:
    [ Fr(~na) ]
    --[ ]->
    [ Out(~na), State_A1($A, $B, ~na) ]

rule Blake_nonce:
    [ Fr(~nb), In(na) ]
    --[ ]->
    [ Out(~nb), State_B1($B, $A, ~nb, na) ]

rule Alex_ack:
    let
        SK = kdf(~na, nb)
    in
    [State_A1($A, $B, ~na), In(nb)]
    --[ Install(SK), DONE($A) ]->
    [Out('ACK'), SK_Installed($A, $B, SK, ~na, nb) ]

rule Blake_ack:
    let
        SK = kdf(na, ~nb)
    in
    [ State_B1($B, $A, ~nb, na), In('ACK') ]
    --[ Install(SK), DONE($B) ]->
    [ SK_Installed($B, $A, SK, na, ~nb) ]


lemma BothDone:
    exists-trace
    " Ex A B #i #j. DONE(A)@i & DONE(B)@j & #i < #j "

// NOTE:
// In this lemma I am using the generic action `DONE(B)`.
// Since I used the action `DONE(...)` for both Alex and Blake in the rules,
// Tamarin does not distinguish the roles: it just sees a "DONE" action with a public name.
// Consequently, this single lemma tests the key secrecy for both actors simultaneously.
// 
// If I wanted to test the secrecy EXCLUSIVELY for Blake (without testing Alex),
// I would have to use different action fact names in the rules:
// - In rule Alex_ack: --[ DONE_A($A) ]->
// - In rule Blake_ack: --[ DONE_B($B) ]->
// And the lemma would be:
// lemma SecureKey_Blake:
//     " All B SK #j. DONE_B(B)@#j & Install(SK)@#j ==> not (Ex #r. K(SK)@#r) "
lemma SecureKey:
    " All B SK #j. DONE(B)@#j & Install(SK)@#j ==> not (Ex #r. K(SK)@#r) "

end
