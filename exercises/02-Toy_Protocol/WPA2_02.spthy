theory WPA2_02
begin

builtins: symmetric-encryption

functions: kdf/3    // SK = kdf(MK, na, nb)

rule init_MK:
    [ Fr(~mk) ]
    --[ ]->
    [ !MK($A, $B, ~mk) ]

rule Alex_nonce:
    [ Fr(~na) ]
    --[ ]->
    [ Out(~na), State_A1($A, $B, ~na) ]

rule Blake_nonce:
    [ Fr(~nb), In(na) ]
    --[ ]->
    [ Out(~nb), State_B1($B, $A, ~nb, na) ]

rule Alex_ack:
    let
        SK = kdf(mk, ~na, nb)
    in
    [State_A1($A, $B, ~na), In(nb), !MK($A, $B, mk) ]
    --[ Install(SK), DONE_A($A) ]->
    [Out('ACK'), SK_Installed($A, $B, SK, ~na, nb) ]

rule Blake_ack:
    let
        SK = kdf(mk, na, ~nb)
    in
    [ State_B1($B, $A, ~nb, na), In('ACK'), !MK($A, $B, mk) ]
    --[ Install(SK), DONE_B($B) ]->
    [ SK_Installed($B, $A, SK, na, ~nb) ]


lemma BothDone:
    exists-trace
    " Ex A B #i #j. DONE_A(A)@i & DONE_B(B)@j & #i < #j "

lemma SecureKey:
    " All B SK #j. DONE_B(B)@#j & Install(SK)@#j ==> not (Ex #r. K(SK)@#r) "

// NOTE:
// It's better to write the IDEAL security property (`all-traces`) rather than looking for an attack trace.
// This way, if an attack exists, the lemma turns RED (Falsified), which visually flags the vulnerability.
// I kept my original `exists-trace` lemma commented out below. It turned GREEN 
// because it successfully found the attack, but standard practice prefers security properties to fail.
//
// lemma OnlyBlakeDone_AttackTrace:
//     exists-trace
//     " Ex B #j. DONE_B(B)@#j & not (Ex A #i. DONE_A(A)@#i & #i < #j) "

lemma Blake_Authentication:
    " All B #j. DONE_B(B)@#j ==> Ex A #i. DONE_A(A)@#i & #i < #j "

end
